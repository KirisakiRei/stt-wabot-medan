APP_NAME=stt-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8001

# STT Engine Configuration
STT_ENGINE=faster_whisper
STT_MODEL=models/small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4
STT_MAX_CONCURRENT_JOBS=2
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Language & Audio Limits
DEFAULT_LANGUAGE=id
INITIAL_PROMPT=Percakapan dan pengaduan layanan publik warga Kota Medan. Mencakup Kantor Wali Kota, Disdukcapil, Dishub, Dinkes, Disdik, DPMPTSP, Bapenda, Satpol PP, kecamatan, kelurahan, kepala dinas, camat, lurah, kepling, KTP elektronik, Kartu Keluarga KK, akta kelahiran, perizinan, dan pengaduan masyarakat.
MAX_AUDIO_SIZE_MB=25
MAX_AUDIO_DURATION_SECONDS=300

# Filesystem & Binaries
TEMP_DIR=/tmp/stt
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Security & API Key (Leave empty to disable authentication in development)
API_KEY=

# Logging
LOG_LEVEL=INFO
